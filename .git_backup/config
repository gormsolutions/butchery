[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "upstream"]
	url = https://github.com/stevesaul/butchery_management.git
	fetch = +refs/heads/main:refs/remotes/upstream/main
[branch "main"]
	remote = upstream
	merge = refs/heads/main
[remote "origin"]
	url = https://github.com/gormsolutions/butchery.git
	fetch = +refs/heads/*:refs/remotes/origin/*
